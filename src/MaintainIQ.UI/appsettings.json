{
  "ConnectionStrings": {
    "MaintainIQ": "Server=.\\SQLEXPRESS;Database=MaintainIQ;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Advisor": {
    "Mode": "Rules",
    "RepeatedFailureThreshold": 3,
    "RepeatedFailureWindowDays": 183,
    "SameCauseThreshold": 3,
    "SameCauseWindowDays": 183,
    "PartReplacementThreshold": 3,
    "PartReplacementWindowDays": 90,
    "MttrThresholdHours": 8,
    "MttrWindowDays": 183,
    "MttrMinimumRepairs": 2,
    "OverdueToleranceDays": 0,
    "WarrantyWarningDays": 30,
    "LlmApiKeyEnvironmentVariable": "MAINTAINIQ_LLM_API_KEY"
  },
  "Kpi": {
    "HourlyLaborRate": 500,
    "Currency": "TRY",
    "PmToleranceDays": 3
  },
  "Attachments": {
    "RootDirectory": "App_Data/attachments",
    "MaxFileSizeBytes": 5242880,
    "ThumbnailMaxPixels": 200
  },
  "MaintenanceEngine": {
    "RunOnStartup": true,
    "TimerIntervalMinutes": 60
  }
}
