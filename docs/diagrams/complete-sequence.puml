@startuml
title WorkOrderService.Complete
actor User
boundary UI
control WorkOrderService
control UnitOfWork
entity WorkOrderRepository
entity SparePartRepository
entity StockMovementRepository
entity EquipmentRepository
entity AuditRepository
database SQLServer

User -> UI : Tamamla(laborHours, parts)
UI -> WorkOrderService : Complete(command, currentUser)
WorkOrderService -> WorkOrderService : Yetki ve domain kuralları
WorkOrderService -> UnitOfWork : Begin()
activate UnitOfWork
group Tek transaction
  WorkOrderService -> WorkOrderRepository : GetWithParts(id)
  WorkOrderRepository -> SQLServer : SELECT WorkOrder + RowVer + Parts
  loop Her parça (Id sırası)
    WorkOrderService -> SparePartRepository : GetForUpdate(partId)
    SparePartRepository -> SQLServer : SELECT WITH (UPDLOCK, ROWLOCK)
    WorkOrderService -> SparePartRepository : Update(decreasedStock, RowVer)
    WorkOrderService -> StockMovementRepository : Add(consumption)
  end
  WorkOrderService -> WorkOrderRepository : Update(completed, RowVer)
  WorkOrderService -> WorkOrderRepository : AddStatusHistory()
  WorkOrderRepository -> SQLServer : UPDATE WorkOrder + INSERT History
  WorkOrderService -> EquipmentRepository : MarkOperational()
  WorkOrderService -> AuditRepository : Add(oldValues, newValues)
  AuditRepository -> SQLServer : INSERT AuditLog
end
alt Başarılı
  WorkOrderService -> UnitOfWork : Commit()
  WorkOrderService --> UI : Success
else Herhangi bir hata
  WorkOrderService -> UnitOfWork : Rollback()
  WorkOrderService --> UI : Açıklanabilir hata
end
deactivate UnitOfWork
@enduml

