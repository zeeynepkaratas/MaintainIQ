@startuml
title Domain Sınıfları

abstract class BaseEntity {
  +Id : int
  +CreatedAt : DateTime
  +UpdatedAt : DateTime
}
abstract class Person
class Technician
class Supervisor
class AdminPerson
class OperatorPerson
class UserAccount
class Equipment
class Failure
class FailureCause
abstract class WorkOrder {
  +Number : string
  +Status : WorkOrderStatus
  +Priority : Priority
  +CalculateCost() : Money
}
class CorrectiveWorkOrder
class PreventiveWorkOrder
class WorkOrderPart
class WorkOrderStatusHistoryEntry
class WorkOrderComment
class SparePart
class StockMovement
class Supplier
class MaintenancePlan
class Attachment
class AuditLog
class Money <<value object>>
class DateRange <<value object>>

BaseEntity <|-- Person
Person <|-- Technician
Person <|-- Supervisor
Person <|-- AdminPerson
Person <|-- OperatorPerson
BaseEntity <|-- Equipment
BaseEntity <|-- Failure
BaseEntity <|-- WorkOrder
WorkOrder <|-- CorrectiveWorkOrder
WorkOrder <|-- PreventiveWorkOrder
BaseEntity <|-- SparePart
Equipment "0..1" o-- "*" Equipment : children
Equipment "1" -- "*" Failure
FailureCause "1" -- "*" Failure
Failure "0..1" -- "1" CorrectiveWorkOrder
MaintenancePlan "0..1" -- "*" PreventiveWorkOrder
WorkOrder "1" o-- "*" WorkOrderPart
SparePart "1" -- "*" WorkOrderPart
WorkOrder "1" o-- "*" WorkOrderStatusHistoryEntry
WorkOrder "1" o-- "*" WorkOrderComment
Supplier "1" -- "*" SparePart
SparePart "1" -- "*" StockMovement
Person "1" -- "0..1" UserAccount
@enduml

